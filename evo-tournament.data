	"vertex": "engine://shaders/debug.vs",
	"fragment": "engine://shaders/debug.fs"
}layout(location = 0) in vec3 aPosition;
layout(location = 1) in vec3 aColor;
layout(location = 2) in float aIsScreenSpace;

#include "engine://shaders/camera_data.glsl"

uniform vec2 uResolution;
out vec3 vColor;

void main()
{
    vColor = aColor;

    if (aIsScreenSpace == 1.0f)
    {
        vec2 ndc = (aPosition.xy / uResolution) * 2.0 - 1.0;
        ndc.y = -ndc.y;

        gl_Position = vec4(ndc, 0.0, 1.0);
    }
    else
    {
        gl_Position = uProjection * uView * vec4(aPosition, 1.0);
    }
}in VS_OUT
{
