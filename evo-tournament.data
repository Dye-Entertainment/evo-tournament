	"vertex": "engine://shaders/gltf/3d_lit.vs",
	"fragment": "engine://shaders/gltf/3d_lit.fs"
}layout(location = 0) in vec3 aPosition;
layout(location = 1) in vec3 aNormal;
layout(location = 2) in vec2 aTexCoords;
layout(location = 3) in vec3 aTangent;

#include "engine://shaders/camera_data.glsl"

out VS_OUT
{
    vec3 FragmentPosition;
    vec2 TexCoords;
    vec3 TangentViewPosition;
    vec3 TangentFragmentPosition;
    vec3 Normal;
    vec4 FragmentPositionLightSpace;
}
vs_out;

uniform mat4 uModel;
uniform mat4 uLightSpaceMatrix;

void main()
{
    vs_out.FragmentPosition = vec3(uModel * vec4(aPosition, 1.0));
    vs_out.TexCoords = aTexCoords;
    vs_out.FragmentPositionLightSpace =
        uLightSpaceMatrix * vec4(vs_out.FragmentPosition, 1.0);

    mat3 normal_matrix = transpose(inverse(mat3(uModel)));

    vec3 tangent = normalize(normal_matrix * aTangent);
    vs_out.Normal = normalize(normal_matrix * aNormal);

    // Orthogonalize tangent against normal
    tangent = normalize(
        tangent - dot(tangent, vs_out.Normal) * vs_out.Normal
    );

    vec3 bitangent = cross(vs_out.Normal, tangent);

    // World space -> tangent space
    mat3 TBN = transpose(mat3(tangent, bitangent, vs_out.Normal));

    // Camera position relative to the fragment
    vec3 viewDirection =
        uViewPosition - vs_out.FragmentPosition;

    vs_out.TangentViewPosition = TBN * viewDirection;

    gl_Position =
        uProjection *
        uView *
        uModel *
        vec4(aPosition, 1.0);
}
in VS_OUT
{
    vec3 FragmentPosition;
    vec2 TexCoords;
    vec3 TangentViewPosition;
    vec3 TangentFragmentPosition;
    vec3 Normal;
    vec4 FragmentPositionLightSpace;
}
fs_in;

out vec4 oFragColor;

#include "engine://shaders/lighting.glsl"

void main()
{
    vec3 normal = texture(uMaterial.normal, fs_in.TexCoords).rgb;
    normal = normalize(normal * 2.0 - 1.0);

    vec4 texture_color = texture(uMaterial.diffuse, fs_in.TexCoords).rgba;

    if (texture_color.a == 0.0f)
    {
        discard;
    }

    vec3 result = ApplyLighting(texture_color.rgb, normal, fs_in.TexCoords, fs_in.FragmentPosition);

    oFragColor = vec4(result.rgb, 1.0);
}{
	"vertex": "engine://shaders/gltf/3d_skinned_lit.vs",
	"fragment": "engine://shaders/gltf/3d_skinned_lit.fs"
}layout(location = 0) in vec3 aPosition;
layout(location = 1) in vec3 aNormal;
layout(location = 2) in vec2 aTexCoord;
layout(location = 3) in ivec4 aBoneIds;
layout(location = 4) in vec4 aWeights;

const int MAX_BONES = 100;
const int MAX_BONE_INFLUENCE = 4;

uniform mat4 uModel;
#include "engine://shaders/camera_data.glsl"

uniform mat4 uFinalBonesMatrices[MAX_BONES];

out VS_OUT
{
    vec3 FragmentPosition;
    vec2 TexCoords;
    vec3 TangentViewPosition;
    vec3 TangentFragmentPosition;
    vec3 Normal;
    vec4 FragmentPositionLightSpace;
}
vs_out;

void main()
{
    vec4 skinnedPos = vec4(0.0);
    vec3 skinnedNorm = vec3(0.0);

    for (int i = 0; i < MAX_BONE_INFLUENCE; ++i)
    {
        const int boneId = aBoneIds[i];
        const float weight = aWeights[i];

        if (boneId < 0 || boneId >= MAX_BONES || weight <= 0.0)
            continue;

        const mat4 boneMatrix = uFinalBonesMatrices[boneId];

        skinnedPos += boneMatrix * vec4(aPosition, 1.0) * weight;
        skinnedNorm += mat3(boneMatrix) * aNormal * weight;
    }

    vs_out.FragmentPosition = (uModel * vec4(aPosition, 1.0)).rgb;
    vs_out.TexCoords = aTexCoord;

    gl_Position = uProjection * uView * uModel * skinnedPos;
}
out vec4 oFragColor;

