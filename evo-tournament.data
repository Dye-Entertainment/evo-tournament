#version 330 core
out vec4 FragColor;
in vec2 TexCoords;
uniform sampler2D screenTexture;
void main()
{
    //Gamma Correction
    vec4 sampledColor = texture(screenTexture, TexCoords);
    float gamma = 2.2;
    sampledColor.rgb = pow(sampledColor.rgb, vec3(1.0 / gamma));
    FragColor = sampledColor;
}
