}#include "engine://shaders/camera_data.glsl"

struct Material
{
    sampler2D diffuse;
    sampler2D specular;
    sampler2D normal;
    float shininess;
};

struct DirectionalLight
{
    vec3 direction;
	float padding1;
	
    vec3 ambient; 
	float padding2;
	
    vec3 diffuse;     
	float padding3;
	
    vec3 specular;
	float padding4;
};

struct PointLight
{
    vec4 position;    // xyz = position, w = radius
	
    vec3 ambient;    
	float padding1;
	
    vec3 diffuse;     
	float padding2;
	
    vec3 specular;   
	float padding3;

    vec3 attenuation; // x = constant, y = linear, z = quadratic
	float padding4;
};

struct SpotLight
{
	vec3 position;
	float cutOff;

	vec3 attenuation; // x = constant, y = linear, z = quadratic
	float outerCutOff;

	vec3 direction;
	float padding1;

	vec3 ambient;
	float padding2;

	vec3 diffuse;
	float padding3;

	vec3 specular;
	float padding4;
};

const int MAX_DIRECTIONAL_LIGHTS = 2;
const int MAX_POINT_LIGHTS = 8;
const int MAX_SPOT_LIGHTS = 8;

layout(std140) uniform LightingData
{
    uniform int uActiveDirectionalLightCount;
    uniform int uActiveSpotLightCount;
    uniform int uActivePointLightCount;
    uniform int padding;
    uniform DirectionalLight uDirectionalLights[MAX_DIRECTIONAL_LIGHTS];
    uniform PointLight uPointLights[MAX_POINT_LIGHTS];
    uniform SpotLight uSpotLights[MAX_SPOT_LIGHTS];
};

uniform Material uMaterial;

uniform sampler2D uShadowMap;

float ShadowCalculation(vec3 normal, vec3 lightDir)
{
    // Transform to NDC
    vec3 projCoords = fs_in.FragmentPositionLightSpace.xyz / fs_in.FragmentPositionLightSpace.w;

    // Convert to [0,1] range
    projCoords = projCoords * 0.5 + 0.5;

   if (projCoords.z < 0.0 ||
        projCoords.z > 1.0 ||
        projCoords.x < 0.0 || projCoords.x > 1.0 ||
        projCoords.y < 0.0 || projCoords.y > 1.0)
    {
        return 0.0;
    }

   float closestDepth = texture(uShadowMap, projCoords.xy).r;
   float currentDepth = projCoords.z;

   vec3 n = normalize(normal);
   vec3 l = normalize(lightDir);

   float bias = max(0.02 * (1.0 - dot(n,l)), 0.005);

   float shadow = 0.0;

   vec2 texelSize = 1.0 / textureSize(uShadowMap,0);

   for(int x=-1; x<=1; x++)
   {
       for(int y=-1; y<=1; y++)
       {
           float pcfDepth =
               texture(uShadowMap,
                       projCoords.xy + vec2(x,y) * texelSize).r;

           shadow += currentDepth - bias > pcfDepth ? 1.0 : 0.0;
       }
   }

   shadow /= 9.0;

   return shadow;
}

vec3 CalculateDirectionalLight(
    DirectionalLight light, vec3 texture_color, vec3 normal, vec3 view_direction,
    vec2 texture_coordinates, Material material
)
{
    const vec3 diffuse_color = texture(material.diffuse, texture_coordinates).xyz;
    const vec3 light_direction = normalize(-light.direction);
    const vec3 ambient = light.ambient * diffuse_color;

    const float light_difference = max(dot(light_direction, normal), 0.0);

    const vec3 diffuse = diffuse_color * light.diffuse * light_difference;
    const vec3 halfway_direction = normalize(light_direction + view_direction);

    float spec = pow(max(dot(view_direction, halfway_direction), 0.0), 32.0);
    vec3 specular = light.specular * spec;

    return ambient + (1.0 - ShadowCalculation(normal,light_direction)) * (diffuse + specular);
}

vec3 CalculatePointLight(
    PointLight light, vec3 normal, vec3 view_direction, vec2 texture_coordinates, Material material,
    vec3 fragment_position
)
{
    const vec3 light_direction = normalize(light.position.xyz - fragment_position);
    const float light_difference = max(dot(normal, light_direction), 0.0);
    const vec3 reflect_direction = reflect(-light_direction, normal);
    const float specular_intensity =
        pow(max(dot(view_direction, reflect_direction), 0.0), material.shininess);

    const float distance = length(light.position.xyz - fragment_position);
    const float attenuation = 1.0 / (light.attenuation.x + light.attenuation.y * distance + light.attenuation.z * (distance * distance));

    vec3 diffuse_color = texture(material.diffuse,texture_coordinates).xyz;
	vec3 ambient = diffuse_color * light.ambient;
	vec3 diffuse = diffuse_color * light.diffuse * light_difference;
	vec3 specular = diffuse_color * light.specular * specular_intensity;

    ambient *= attenuation;
    diffuse *= attenuation;
    specular *= attenuation;

    return ambient + (diffuse + specular) * attenuation;
}

vec3 CalculateSpotLight(
    SpotLight light, vec3 normal, vec3 view_direction, vec2 texture_coordinates, Material material,
    vec3 fragment_position
)
{
    const vec3 light_direction = normalize(light.position.xyz - fragment_position);
    const float light_difference = max(dot(normal, light_direction), 0.0);
    const vec3 reflect_direction = reflect(-light_direction, normal);
    const float specular_intensity =
        pow(max(dot(view_direction, reflect_direction), 0.0), material.shininess);

    const float distance = length(light.position.xyz - fragment_position);
    const float attenuation = 1.0 / (light.attenuation.x + light.attenuation.y * distance + light.attenuation.z * (distance * distance));

    const float theta = dot(light_direction, normalize(-light.direction));
    const float epsilon = light.cutOff - light.outerCutOff;
    const float intensity = clamp(
    (theta - light.outerCutOff) / epsilon,
    0.0,
    1.0
    );

    vec3 diffuse_color = texture(material.diffuse, texture_coordinates).xyz;
	vec3 ambient = diffuse_color * light.ambient;
	vec3 diffuse = diffuse_color * light.diffuse * light_difference;
	vec3 specular = diffuse_color * light.specular * specular_intensity;

    ambient *= attenuation;
    diffuse *= attenuation;
    specular *= attenuation;

    return ambient + (diffuse + specular) * attenuation;
}

vec3 ApplyLighting(
    vec3 texture_color, vec3 normal, vec2 texture_coordinates, vec3 fragment_position
)
{
    const vec3 view_direction = normalize(uViewPosition - fragment_position);

    vec3 result = vec3(0.0);
    for (int i = 0; i < min(uActiveDirectionalLightCount, MAX_DIRECTIONAL_LIGHTS); ++i)
    {
        result += CalculateDirectionalLight(
            uDirectionalLights[i], texture_color, normal, view_direction, texture_coordinates,
            uMaterial
        );
    }

    return result;
}
#version 330 core
out vec4 FragColor;
in vec2 TexCoords;
uniform sampler2D screenTexture;
const float offset = 1.0 / 300.0;

void main()
{
    vec2 offsets[9] = vec2[](
        vec2(-offset, offset),  // top-left
        vec2(0.0f, offset),     // top-center
        vec2(offset, offset),   // top-right
        vec2(-offset, 0.0f),    // center-left
        vec2(0.0f, 0.0f),       // center-center
        vec2(offset, 0.0f),     // center-right
        vec2(-offset, -offset), // bottom-left
        vec2(0.0f, -offset),    // bottom-center
        vec2(offset, -offset)   // bottom-right
    );
    float kernel[9] = float[](
        1.0 / 16, 2.0 / 16, 1.0 / 16, 2.0 / 16, 4.0 / 16, 2.0 / 16, 1.0 / 16, 2.0 / 16, 1.0 / 16
    );

    vec3 sampleTex[9];
    for (int i = 0; i < 9; i++)
    {
        sampleTex[i] = vec3(texture(screenTexture, TexCoords.st + offsets[i]));
    }
    vec3 col = vec3(0.0);
    for (int i = 0; i < 9; i++)
        col += sampleTex[i] * kernel[i];
    FragColor = vec4(col, 1.0);
}
