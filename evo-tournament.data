}/* Evo Tournament UI. Sizes are in dp: the game scales them down on small windows. */

/* RmlUi has no default style sheet. */
div, p, h1, h2, ul, li { display: block; }

body
{
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    font-family: "DejaVu Sans";
    font-weight: bold;
    font-size: 17dp;
    color: #ffffff;
    pointer-events: none;
}
.accent { color: #ff8c28; }
.dim { color: #aaaab9; }
.muted { color: #9999ad; }
.shadow { font-effect: shadow(2dp 2dp #000000aa); }

/* ---------- Menus ---------- */

.layer
{
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    display: flex;
    justify-content: center;
    align-items: center;
}
/* Clipping an element with rounded corners makes RmlUi draw a stencil clip mask, which is
   expensive on the web (several extra full-screen passes and synchronous GL queries per frame).
   So rounded elements never clip: scrolling happens in .scroll, and text in .field inputs,
   both with square corners, which RmlUi clips with a plain scissor rectangle. */
.panel
{
    pointer-events: auto;
    padding: 18dp 0 18dp 22dp;
    background-color: #0f0f17eb;
    border: 1dp #ff8c2659;
    border-radius: 10dp;
}
.scroll { max-height: 86vh; overflow-y: auto; padding-right: 22dp; }
#menu .panel { width: 560dp; }
#connecting .panel { width: 460dp; }
#pause .panel { width: 480dp; }
#pause { background-color: #0000005a; }

h1 { text-align: center; font-size: 46dp; line-height: 54dp; color: #ff8c28; }
h2 { text-align: center; font-size: 28dp; line-height: 36dp; color: #ff8c28; }
.subtitle { text-align: center; font-size: 15dp; color: #aaaab9; }
.center { text-align: center; }
.big { font-size: 26dp; line-height: 34dp; }
.gap { height: 9dp; }
.rule { height: 1dp; margin: 9dp 0; background-color: #ff8c264d; }
.section
{
    margin: 12dp 0 8dp 0;
    padding-bottom: 4dp;
    border-bottom: 1dp #ff8c264d;
    color: #ffffff;
}
.label { margin-bottom: 6dp; }
.help { font-size: 15dp; line-height: 21dp; color: #9999ad; margin: 6dp 0; }
.error-text { color: #ff7359; line-height: 24dp; margin-bottom: 9dp; }

.button
{
    display: block;
    height: 34dp;
    line-height: 34dp;
    margin: 0 0 9dp 0;
    text-align: center;
    background-color: #d96b1ad9;
    border-radius: 6dp;
    cursor: pointer;
}
.button:hover { background-color: #ff8c2e; }
.button:active { background-color: #bf590d; }
.button.huge { height: 48dp; line-height: 48dp; font-size: 21dp; }
.button.large { height: 40dp; line-height: 40dp; font-size: 19dp; }

.row { display: flex; align-items: center; margin-bottom: 9dp; }

/* Arena picker */
.maps { display: flex; margin-bottom: 2dp; }
.map
{
    flex: 1;
    height: 52dp;
    line-height: 52dp;
    margin-right: 8dp;
    text-align: center;
    font-size: 16dp;
    border-radius: 6dp;
    border: 2dp #00000000;
    cursor: pointer;
    font-effect: shadow(2dp 2dp #000000cc);
}
.map:last-child { margin-right: 0; }
.map.bastion { decorator: vertical-gradient(#c8603c #2a1a3a); }
.map.foundry { decorator: vertical-gradient(#9a3a10 #1c0d08); }
.map.frost { decorator: vertical-gradient(#1e5a78 #0a1022); }
.map:hover { border-color: #ffffff66; }
.map.selected { border-color: #ff8c28; }
.row .grow { flex: 1; }
.row .button { margin: 0 0 0 10dp; padding: 0 16dp; }
.row .button.first { margin-left: 0; }

.field
{
    height: 34dp;
    padding: 0 10dp;
    background-color: #242430;
    border-radius: 6dp;
    cursor: text;
}
.field:hover { background-color: #33333f; }
input.text
{
    display: block;
    box-sizing: border-box;
    width: 100%;
    height: 34dp;
    padding: 7dp 0;
    color: #ffffff;
    cursor: text;
    pointer-events: auto;
}
input.text:placeholder-shown { color: #8c8c99; }
input.text selection { background-color: #ff8c2880; color: #ffffff; }
.row .field { flex: 1; }
.row .field.port { flex: 0 0 120dp; margin: 0 10dp; }

/* Sliders: the track, the value and the label, like the old ImGui sliders. */
.slider { display: flex; align-items: center; margin-bottom: 9dp; }
.slider .control
{
    position: relative;
    flex: 0 0 250dp;
    height: 30dp;
    background-color: #242430;
    border-radius: 6dp;
}
.slider .control:hover { background-color: #33333f; }
.slider .value
{
    position: absolute;
    left: 0; top: 0; width: 250dp;
    line-height: 30dp;
    text-align: center;
    pointer-events: none;
}
.slider .name { margin-left: 10dp; }
input.range
{
    position: absolute;
    left: 0; top: 0;
    width: 250dp;
    height: 30dp;
    cursor: pointer;
}
input.range slidertrack { height: 30dp; }
input.range sliderbar
{
    margin-top: 4dp;
    width: 14dp;
    height: 22dp;
    background-color: #ff8c26;
    border-radius: 6dp;
}
input.range sliderbar:hover, input.range sliderbar:active { background-color: #ffb34d; }
input.range sliderarrowdec, input.range sliderarrowinc { width: 0; height: 0; }

.check { display: flex; align-items: center; margin-bottom: 9dp; cursor: pointer; }
input.checkbox
{
    width: 26dp;
    height: 26dp;
    margin-right: 10dp;
    background-color: #242430;
    border-radius: 6dp;
    cursor: pointer;
}
input.checkbox:hover { background-color: #33333f; }
input.checkbox:checked { background-color: #ff9933; border: 6dp #242430; }

.header
{
    height: 30dp;
    line-height: 30dp;
    padding: 0 10dp;
    margin-bottom: 6dp;
    background-color: #4d3324cc;
    border-radius: 4dp;
    cursor: pointer;
}
.header:hover { background-color: #73472ae6; }
.header .arrow { display: inline-block; width: 22dp; color: #ff9933; }
.bullets div { font-size: 15dp; line-height: 22dp; padding-left: 16dp; }

.link
{
    padding: 7dp 10dp;
    background-color: #242430;
    border-radius: 6dp;
    font-size: 13dp;
}
.link div { overflow: hidden; white-space: nowrap; }

scrollbarvertical { width: 8dp; margin-left: 4dp; }
scrollbarvertical slidertrack { background-color: #ffffff10; border-radius: 4dp; }
scrollbarvertical sliderbar { background-color: #ff8c2680; border-radius: 4dp; }
scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc { width: 0; height: 0; }

#error
{
    position: absolute;
    left: 0; right: 0; bottom: 8%;
    display: flex;
    justify-content: center;
}
#error .panel { width: 520dp; }

/* ---------- HUD ---------- */

#hud { position: absolute; left: 0; top: 0; right: 0; bottom: 0; font-effect: shadow(2dp 2dp #000000aa); }
.box { position: absolute; background-color: #08080e96; border-radius: 10dp; }

.flash { position: absolute; }
.flash.left { left: 0; top: 0; bottom: 0; width: 160dp; decorator: linear-gradient(to right, #c80000, #c8000000); }
.flash.right { right: 0; top: 0; bottom: 0; width: 160dp; decorator: linear-gradient(to left, #c80000, #c8000000); }
.flash.top { left: 0; right: 0; top: 0; height: 160dp; decorator: linear-gradient(to bottom, #c80000, #c8000000); }
.flash.bottom { left: 0; right: 0; bottom: 0; height: 160dp; decorator: linear-gradient(to top, #c80000, #c8000000); }

/* Crosshair: lines drawn as thin boxes around the screen centre. */
#crosshair { position: absolute; left: 50%; top: 50%; width: 0; height: 0; }
#crosshair div { position: absolute; background-color: #ffffffe6; border: 1dp #000000aa; box-sizing: content-box; }
#crosshair .h { height: 2dp; margin-top: -2dp; }
#crosshair .v { width: 2dp; margin-left: -2dp; }
#crosshair .ring { left: -10dp; top: -10dp; width: 16dp; height: 16dp; border-radius: 10dp; background-color: transparent; border: 2dp #ffffffe6; }
#crosshair .dot { left: -2dp; top: -2dp; width: 3dp; height: 3dp; border-radius: 2dp; border-width: 0; }
#crosshair .hit { width: 11dp; height: 3dp; margin-top: -2dp; margin-left: -6dp; background-color: #ff3c32; border-width: 0; }

#health { left: 24dp; bottom: 24dp; width: 330dp; height: 72dp; }
#health .cross-h { position: absolute; left: 20dp; top: 30dp; width: 24dp; height: 10dp; background-color: #ff463c; }
#health .cross-v { position: absolute; left: 27dp; top: 23dp; width: 10dp; height: 24dp; background-color: #ff463c; }
#health .shield { position: absolute; left: 180dp; top: 22dp; width: 24dp; height: 22dp; background-color: #ffcd3c; border-radius: 3dp 3dp 12dp 12dp; }
.number { position: absolute; top: 6dp; font-size: 46dp; line-height: 56dp; }
#health .hp { left: 54dp; }
#health .ap { left: 214dp; }
.low { color: #ff463c; }
.empty { color: #aaaab999; }

#ammo { right: 24dp; bottom: 24dp; width: 230dp; height: 72dp; }
#ammo .name { position: absolute; left: 18dp; top: 10dp; font-size: 15dp; }
#ammo .number { right: 18dp; text-align: right; }

#slots { position: absolute; right: 24dp; bottom: 104dp; width: 230dp; height: 36dp; }
.slot { position: absolute; top: 0; width: 72dp; height: 36dp; background-color: #08080e96; border-radius: 6dp; }
.slot.selected { background-color: #ff8c2878; }
.slot .label { position: absolute; left: 6dp; top: 3dp; font-size: 12dp; margin: 0; }
.slot .count { position: absolute; right: 6dp; top: 16dp; font-size: 14dp; }
.slot.missing .label, .slot.missing .count { color: #6e6e78a0; }

#respawn { position: absolute; left: 0; right: 0; top: 62%; text-align: center; font-size: 24dp; }

#timer { left: 50%; margin-left: -70dp; top: 12dp; width: 140dp; height: 60dp; text-align: center; }
#timer .time { font-size: 30dp; line-height: 38dp; margin-top: 2dp; }
#timer .limit { font-size: 12dp; color: #aaaab9; }

#rank { right: 14dp; top: 12dp; width: 186dp; height: 86dp; }
#rank .place { position: absolute; left: 14dp; top: 2dp; font-size: 36dp; line-height: 46dp; }
#rank .of { position: absolute; right: 14dp; top: 10dp; font-size: 14dp; color: #aaaab9; }
#rank .frags { position: absolute; left: 14dp; top: 52dp; font-size: 18dp; }
#rank .lead { position: absolute; right: 14dp; top: 54dp; font-size: 16dp; color: #ff7864; }
#rank .lead.good { color: #78ff8c; }

#feed { position: absolute; right: 14dp; top: 112dp; width: 600dp; text-align: right; }
#feed .entry { margin-bottom: 5dp; }
#feed .entry span.pill { display: inline-block; padding: 3dp 10dp; background-color: #08080e96; border-radius: 5dp; font-size: 16dp; }
#feed .entry.involved span.pill { background-color: #783c0a96; }
#feed .weapon { color: #aaaab9; }

.nameplate { position: absolute; width: 300dp; margin-left: -150dp; text-align: center; }

#notices { position: absolute; left: 20dp; top: 18dp; }
#notices .status { color: #78dcff; font-size: 16dp; margin-bottom: 6dp; }
#notices .notice { font-size: 15dp; margin-bottom: 4dp; }

#banner { position: absolute; left: 0; right: 0; top: 26%; text-align: center; }
#banner .main { font-size: 34dp; line-height: 44dp; }
#banner .sub { font-size: 18dp; }
#pickup { position: absolute; left: 0; right: 0; bottom: 130dp; text-align: center; font-size: 20dp; }

#scoreboard { position: absolute; left: 0; right: 0; top: 60dp; display: flex; justify-content: center; }
#scoreboard .board
{
    position: relative;
    width: 640dp;
    padding: 16dp 0 20dp 0;
    background-color: #06060cd7;
    border: 2dp #ff8c2878;
    border-radius: 12dp;
}
#scoreboard .title { text-align: center; font-size: 30dp; line-height: 36dp; color: #ff8c28; margin-bottom: 12dp; }
.score-row { position: relative; height: 30dp; margin: 0 14dp; }
.score-row.local { background-color: #ff8c2837; border-radius: 6dp; }
.score-row span { position: absolute; top: 4dp; }
.score-row .rank { left: 16dp; }
.score-row .swatch { left: 42dp; top: 7dp; width: 6dp; height: 15dp; }
.score-row .name { left: 56dp; }
.score-row .tag { font-size: 12dp; color: #aaaab9; margin-left: 10dp; top: 4dp; position: relative; }
.score-row .frags { left: 386dp; width: 100dp; text-align: center; }
.score-row .deaths { left: 486dp; width: 100dp; text-align: center; color: #aaaab9; }
.score-head { height: 24dp; font-size: 14dp; color: #aaaab9; }
.score-head span { top: 0; }
<rml>
<head>
    <title>Evo Tournament</title>
    <link type="text/rcss" href="evo.rcss"/>
</head>
<body data-model="evo">

<!-- ================= HUD ================= -->
<div id="hud" data-if="screen == 'match'">
    <div data-if="damage > 0" data-style-opacity="damage * 0.43">
        <div class="flash left"></div><div class="flash right"></div>
        <div class="flash top"></div><div class="flash bottom"></div>
    </div>

    <div data-for="n : nameplates">
        <div class="nameplate" data-style-left="n.x + 'dp'" data-style-top="(n.y - n.size) + 'dp'"
             data-style-font-size="n.size + 'dp'" data-style-color="n.color" data-style-opacity="n.alpha">{{ n.name }}</div>
    </div>

    <div data-if="alive">
        <div id="crosshair">
            <div data-if="crosshair == 'rifle'">
                <div class="h" style="left: -11dp; width: 7dp;"></div>
                <div class="h" style="left: 4dp; width: 7dp;"></div>
                <div class="v" style="top: -11dp; height: 7dp;"></div>
                <div class="v" style="top: 4dp; height: 7dp;"></div>
            </div>
            <div data-if="crosshair == 'nova'">
                <div class="h" style="left: -14dp; width: 8dp;"></div>
                <div class="h" style="left: 6dp; width: 8dp;"></div>
                <div class="v" style="top: 6dp; height: 8dp;"></div>
                <div class="dot"></div>
            </div>
            <div data-if="crosshair == 'rail'">
                <div class="ring"></div>
                <div class="dot"></div>
            </div>
            <div data-if="hit > 0" data-style-opacity="hit">
                <div class="hit" style="left: 11dp; top: 11dp; transform: rotate(45deg);"></div>
                <div class="hit" style="left: -11dp; top: -11dp; transform: rotate(45deg);"></div>
                <div class="hit" style="left: 11dp; top: -11dp; transform: rotate(-45deg);"></div>
                <div class="hit" style="left: -11dp; top: 11dp; transform: rotate(-45deg);"></div>
            </div>
        </div>

        <div id="health" class="box">
            <div class="cross-h"></div><div class="cross-v"></div>
            <div class="number hp" data-class-low="healthLow" data-style-opacity="healthAlpha">{{ health }}</div>
            <div class="shield"></div>
            <div class="number ap" data-class-empty="armor <= 0">{{ armor }}</div>
        </div>

        <div id="slots">
            <div data-for="s, i : slots" class="slot" data-class-selected="s.selected" data-class-missing="!s.owned"
                 data-style-left="(i * 78) + 'dp'">
                <div class="label" data-style-color="s.color">{{ s.label }}</div>
                <div class="count">{{ s.ammo }}</div>
            </div>
        </div>
        <div id="ammo" class="box">
            <div class="name" data-style-color="weaponColor">{{ weaponName }}</div>
            <div class="number" data-class-low="ammo <= 0">{{ ammo }}</div>
        </div>
    </div>
    <div id="respawn" data-if="respawn" data-style-opacity="respawnAlpha">Click to respawn</div>

    <div id="timer" class="box">
        <div class="time" data-class-low="timerLow">{{ timer }}</div>
        <div class="limit">FRAG LIMIT {{ matchFragLimit }}</div>
    </div>

    <div id="rank" class="box" data-if="hasRank">
        <div class="place" data-class-accent="rankFirst">{{ rank }}</div>
        <div class="of">{{ rankOf }}</div>
        <div class="frags">{{ fragsText }}</div>
        <div class="lead" data-class-good="leadGood">{{ lead }}</div>
    </div>

    <div id="feed">
        <div class="entry" data-for="f : feed" data-class-involved="f.involved" data-style-opacity="f.alpha">
            <span class="pill"><span data-if="!f.suicide" data-style-color="f.killerColor">{{ f.killer }}</span><span class="weapon">{{ f.weapon }}</span><span data-style-color="f.victimColor">{{ f.victim }}</span></span>
        </div>
    </div>

    <div id="notices">
        <div class="status" data-if="status != ''">{{ status }}</div>
        <div class="notice" data-for="n : notices" data-style-opacity="n.alpha">{{ n.text }}</div>
    </div>

    <div id="banner" data-if="bannerAlpha > 0" data-style-opacity="bannerAlpha">
        <div class="main" data-style-color="bannerColor">{{ banner }}</div>
        <div class="sub" data-if="bannerSub != ''">{{ bannerSub }}</div>
    </div>
    <div id="pickup" data-if="pickupAlpha > 0" data-style-opacity="pickupAlpha" data-style-color="pickupColor">{{ pickup }}</div>

    <div id="scoreboard" data-if="scoreboard">
        <div class="board">
            <div class="title">{{ scoreTitle }}</div>
            <div class="score-row score-head">
                <span class="rank">#</span><span class="name">PLAYER</span>
                <span class="frags">FRAGS</span><span class="deaths">DEATHS</span>
            </div>
            <div class="score-row" data-for="r : scores" data-class-local="r.local">
                <span class="rank">{{ r.rank }}</span>
                <span class="swatch" data-style-background-color="r.color"></span>
                <span class="name" data-class-accent="r.local">{{ r.name }}<span class="tag" data-if="r.tag != ''">{{ r.tag }}</span></span>
                <span class="frags">{{ r.frags }}</span>
                <span class="deaths">{{ r.deaths }}</span>
            </div>
        </div>
    </div>
</div>

<!-- ================= Pause menu ================= -->
<div id="pause" class="layer" data-if="screen == 'match' &amp;&amp; pause">
    <div class="panel"><div class="scroll">
        <h2>{{ pauseTitle }}</h2>
        <div class="gap"></div>
        <div data-if="isHost">
            <div class="section">Invite friends</div>
            <div data-if="roomCodes">
                <div class="center big">{{ roomCodeText }}</div>
                <div class="row">
                    <div class="link grow"><div>{{ inviteLink }}</div></div>
                    <div class="button" data-event-click="action('copy')">Copy</div>
                </div>
            </div>
            <div data-if="!roomCodes">Friends join with  &lt;your-ip&gt;:{{ roomCodeText }}</div>
            <div class="muted">{{ friends }}</div>
        </div>
        <div data-if="connectedTo != ''">{{ connectedTo }}</div>
        <div data-if="showBots">
            <div class="section">Bots</div>
            <div class="slider">
                <div class="control"><input type="range" min="0" max="11" step="1" data-value="botCount"/><div class="value">{{ botCount }}</div></div>
                <span class="name">Bots</span>
            </div>
            <div class="slider">
                <div class="control"><input type="range" min="0" max="1" step="0.01" data-value="botSkill"/><div class="value">{{ skillName }}</div></div>
                <span class="name">Bot skill</span>
            </div>
        </div>
        <div class="header" data-event-click="showPauseOptions = !showPauseOptions">
            <span class="arrow">{{ showPauseOptions ? 'v' : '&gt;' }}</span>Options
        </div>
        <div data-if="showPauseOptions">
            <div class="slider">
                <div class="control"><input type="range" min="0.1" max="5" step="0.05" data-value="sensitivity"/><div class="value">{{ sensitivity | format(2) }}</div></div>
                <span class="name">Mouse sensitivity</span>
            </div>
            <div class="slider">
                <div class="control"><input type="range" min="80" max="120" step="1" data-value="fov"/><div class="value">{{ fov | format(0) }}</div></div>
                <span class="name">Field of view</span>
            </div>
            <div class="slider">
                <div class="control"><input type="range" min="0" max="1" step="0.01" data-value="volume"/><div class="value">{{ volume | format(2) }}</div></div>
                <span class="name">Volume</span>
            </div>
            <label class="check"><input type="checkbox" data-checked="invertY"/>Invert mouse</label>
            <label class="check"><input type="checkbox" data-checked="gore"/>Blood and gore</label>
        </div>
        <div class="gap"></div>
        <div class="button" data-if="showResume" data-event-click="action('resume')">Resume</div>
        <div class="button" data-event-click="action('leave')">Leave match</div>
    </div></div>
</div>

<!-- ================= Main menu ================= -->
<div id="menu" class="layer" data-if="screen == 'menu'">
    <div class="panel"><div class="scroll">
        <h1>EVO TOURNAMENT</h1>
        <div class="subtitle">Arena deathmatch  -  built on the evogine engine</div>
        <div class="rule"></div>

        <div class="label">Your name</div>
        <div class="field"><input type="text" class="text" maxlength="15" data-value="name"/></div>
        <div class="gap"></div>

        <div class="label">Arena</div>
        <div class="maps">
            <div class="map bastion" data-class-selected="arena == 0" data-event-click="action('arena0')">BASTION</div>
            <div class="map foundry" data-class-selected="arena == 1" data-event-click="action('arena1')">FOUNDRY</div>
            <div class="map frost" data-class-selected="arena == 2" data-event-click="action('arena2')">FROSTSPIRE</div>
        </div>
        <div class="help">{{ arenaDescription }}</div>
        <div class="button huge" data-event-click="action('instant')">INSTANT ACTION</div>
        <div class="slider">
            <div class="control"><input type="range" min="0" max="11" step="1" data-value="botCount"/><div class="value">{{ botCount }}</div></div>
            <span class="name">Bots</span>
        </div>
        <div class="slider">
            <div class="control"><input type="range" min="0" max="1" step="0.01" data-value="botSkill"/><div class="value">{{ skillName }}</div></div>
            <span class="name">Bot skill</span>
        </div>

        <div class="section">Online</div>
        <div class="row">
            <span data-if="!roomCodes">UDP port</span>
            <div class="field port" data-if="!roomCodes"><input type="text" class="text" maxlength="6" data-value="hostPort"/></div>
            <div class="button large grow first" data-event-click="action('host')">HOST ONLINE MATCH</div>
        </div>
        <div class="row">
            <div class="field"><input type="text" class="text" maxlength="63" data-value="joinText" data-attr-placeholder="roomCodes ? 'Room code' : 'host:port'"/></div>
            <div class="button large" data-event-click="action('join')">JOIN</div>
        </div>
        <div class="help">{{ onlineHelp }}</div>

        <div class="header" data-event-click="showMatch = !showMatch">
            <span class="arrow">{{ showMatch ? 'v' : '&gt;' }}</span>Match settings
        </div>
        <div data-if="showMatch">
            <div class="slider">
                <div class="control"><input type="range" min="5" max="50" step="1" data-value="fragLimit"/><div class="value">{{ fragLimit }}</div></div>
                <span class="name">Frag limit</span>
            </div>
            <div class="slider">
                <div class="control"><input type="range" min="2" max="30" step="1" data-value="timeLimit"/><div class="value">{{ timeLimit }}</div></div>
                <span class="name">Time limit (min)</span>
            </div>
        </div>
        <div class="header" data-event-click="showOptions = !showOptions">
            <span class="arrow">{{ showOptions ? 'v' : '&gt;' }}</span>Options
        </div>
        <div data-if="showOptions">
            <div class="slider">
                <div class="control"><input type="range" min="0.1" max="5" step="0.05" data-value="sensitivity"/><div class="value">{{ sensitivity | format(2) }}</div></div>
                <span class="name">Mouse sensitivity</span>
            </div>
            <div class="slider">
                <div class="control"><input type="range" min="80" max="120" step="1" data-value="fov"/><div class="value">{{ fov | format(0) }}</div></div>
                <span class="name">Field of view</span>
            </div>
            <div class="slider">
                <div class="control"><input type="range" min="0" max="1" step="0.01" data-value="volume"/><div class="value">{{ volume | format(2) }}</div></div>
                <span class="name">Volume</span>
            </div>
            <label class="check"><input type="checkbox" data-checked="invertY"/>Invert mouse</label>
            <label class="check"><input type="checkbox" data-checked="gore"/>Blood and gore</label>
        </div>
        <div class="header" data-event-click="showControls = !showControls">
            <span class="arrow">{{ showControls ? 'v' : '&gt;' }}</span>Controls
        </div>
        <div class="bullets" data-if="showControls">
            <div>- WASD / arrows - move,  mouse - aim,  left click - fire</div>
            <div>- Space - jump, press again in the air to double jump</div>
            <div>- Double-tap a direction or press Shift - dodge</div>
            <div>- Jump along a wall while holding W - wall run, Space to kick off</div>
            <div>- 1 2 3 / mouse wheel / Q - switch weapons</div>
            <div>- Tab - scoreboard,  Esc - menu</div>
        </div>
    </div></div>
</div>

<!-- ================= Connecting ================= -->
<div id="connecting" class="layer" data-if="screen == 'connecting'">
    <div class="panel"><div class="scroll">
        <h2>CONNECTING</h2>
        <div class="gap"></div>
        <div class="center">{{ connectStatus }}</div>
        <div class="gap"></div>
        <div class="button" data-event-click="action('cancel')">Cancel</div>
    </div></div>
</div>

<!-- ================= Errors ================= -->
<div id="error" data-if="error != ''">
    <div class="panel"><div class="scroll">
        <div class="error-text">{{ error }}</div>
        <div class="button" data-event-click="action('error-ok')">OK</div>
    </div></div>
</div>

</body>
</rml>
